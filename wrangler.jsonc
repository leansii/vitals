{
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
	"name": "vitals",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	// Probe every 15 minutes. The DB-touching part of the check is throttled
	// separately, per target, via `deep_every_minutes` — see below. That split is
	// the whole point: frontend probes are free, so they run every tick and catch
	// an outage in <=15 min, while the deep probe wakes a scale-to-zero Postgres
	// and is therefore rationed.
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	// Optional: a custom domain for the on-demand probe, so it doesn't depend on
	// the workers.dev subdomain. The zone must be on the same Cloudflare account.
	// Declaring it here rather than only in the dashboard keeps the deploy
	// reproducible. Delete this block if you don't want a stable hostname — the
	// cron runs regardless, and without MANUAL_PROBE_KEY the handler 404s anyway.
	"routes": [
		{
			"pattern": "vitals.leansii.com",
			"custom_domain": true
		}
	],
	// Declaring a route makes wrangler disable the workers.dev subdomain by
	// default; stating it silences the warning and pins the intent — the worker
	// is reachable at the custom domain only. Set both to true (or drop
	// "routes") to go back to <name>.<subdomain>.workers.dev.
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		// The monitored projects. One entry per project — adding a project is a
		// config entry plus its health-key secret, no code change. See
		// config.example.jsonc for every field and README.md for the model.
		// NOTHING SECRET GOES HERE: this file is committed. Health keys are
		// Worker secrets, referenced by name via `health_key_secret`.
		"TARGETS": [
			{
				"name": "cyclecare-api",
				"api_url": "https://api.getcyclecare.com",
				"expected": "auth=on,auth_emulator=off,storage=on,covers=on,embeddings=on,passkeys=on,cors=on,frontend_url=on,tls=off",
				// The frontend, plus the API's dependency-free liveness route. /livez
				// answers 200 whenever the process is up, even with Postgres down,
				// so probing it every tick costs nothing against the Neon quota and
				// still catches "the API is gone" within one cron interval — which
				// is what lets deep_every_minutes back off.
				// NOT /healthz: that exact path is intercepted above the container
				// and never reaches the app (verified 2026-08-19 — a random path and
				// even "/healthz/" with a trailing slash both reach it; "/healthz"
				// alone returns a Google HTML 404).
				"web_targets": "https://app.getcyclecare.com,https://api.getcyclecare.com/livez",
				"client_err_threshold": "3",
				"health_key_secret": "HEALTH_KEY_CYCLECARE",
				// The API pings Neon. A woken Neon compute stays up for its idle
				// timeout — a fixed 5 min on the Free plan — so every deep probe costs
				// >=5 min of compute against a 100 CU-hour/month/project quota:
				//   every 15 min  96/day x 5 min = 8 h/day ~= 60 CU-h/month (60% of it)
				//   every 60 min  24/day x 5 min = 2 h/day ~= 15 CU-h/month
				// At the faster rate the monitor exhausted the quota on its own, Neon
				// suspended the compute, and the watchman took down what it watched.
				// Cost of hourly: a dead DB is reported up to an hour late, and
				// client_errors.new_signatures_15m is a 15-min window, so it now samples
				// 15 min out of every 60 — brief spikes in between are missed.
				"deep_every_minutes": 60
			}
		]
	},
	// Secrets (set once with `npx wrangler secret put <NAME>`, NOT in this file):
	//   TELEGRAM_BOT_TOKEN     ← from @BotFather
	//   TELEGRAM_CHAT_ID       ← your chat id (message the bot, then
	//                            GET https://api.telegram.org/bot<token>/getUpdates
	//                            and read chat.id)
	//   HEALTH_KEY_CYCLECARE   ← one per target, named by its `health_key_secret`;
	//                            same value as the backend's own health key
	//   MANUAL_PROBE_KEY       ← optional; gates the on-demand GET / probe.
	//                            Unset = the fetch handler is disabled (404s).
	"observability": {
		"enabled": true
	},
	// KV state: one `last-signature:<target>` key per target. Lets the worker
	// alert on state CHANGE + send a 🟢 recovery message instead of re-alerting
	// every failing tick, independently per target. Binding name must stay
	// "STATE" — that's what src/index.ts reads (env.STATE). Create your own with:
	//   npx wrangler kv namespace create HEALTH_STATE
	// then paste the printed id below (a namespace id is account-scoped, not a
	// secret). Remove the whole block to run stateless (alerts every failing tick).
	"kv_namespaces": [
		{
			"binding": "STATE",
			"id": "b4dd8e2cb1a64270aa1950d8d4fb62ba",
			"remote": true
		}
	]
}
